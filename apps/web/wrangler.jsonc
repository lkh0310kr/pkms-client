{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pkms-cloud",
  "main": "workers/app.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSET_FILES"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://pkms-cloud.lkh0310kr.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountStore" },
      { "name": "VAULT_ROOMS", "class_name": "VaultRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountStore", "VaultRoom"] }
  ],
  "r2_buckets": [
    { "binding": "ASSET_BUCKET", "bucket_name": "pkms-attachments" }
  ]
}
